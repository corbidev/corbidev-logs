# ============================================================
# FICHIER MODELE .env
#
# Plateforme de logs mutualisée Symfony 8
#
# Philosophie :
# - simplicité
# - robustesse
# - mutualisé compatible
# - zéro magie
# ============================================================

####> VARIABLES A RENSEIGNER #################################

# ------------------------------------------------------------
# Projet
# ------------------------------------------------------------

APP_NAME=logs-platform
APP_ENV=dev
APP_DEBUG=1

APP_VERSION=1.0.0

# IMPORTANT :
# Générer une vraie valeur sécurisée en production
APP_SECRET=change-this-secret


# ------------------------------------------------------------
# Domaine
# ------------------------------------------------------------

APP_SCHEME=https
APP_DOMAIN=logs.test

APP_URL=${APP_SCHEME}://${APP_DOMAIN}


# ------------------------------------------------------------
# MariaDB / MySQL
# ------------------------------------------------------------

MARIADB_VERSION=11.7.0

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

DATABASE_NAME=logs_platform
DATABASE_USER=user
DATABASE_PASSWORD=password


# ------------------------------------------------------------
# Mail
# ------------------------------------------------------------

MAIL_FROM=noreply@example.com
MAIL_TO=admin@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASSWORD=password
SMTP_ENCRYPTION=tls


# ------------------------------------------------------------
# Queue disque
# ------------------------------------------------------------

# Répertoire principal de queue
QUEUE_DIR=var/queue

# Répertoire des fichiers corrompus
QUEUE_FAILED_DIR=var/queue_failed

# Nombre max de retries
QUEUE_MAX_RETRIES=3


# ------------------------------------------------------------
# Logs plateforme
# ------------------------------------------------------------

# Niveau minimal des logs Symfony internes
APP_LOG_LEVEL=warning

# Durée conservation logs (jours)
LOG_RETENTION_DAYS=30

# Taille max payload brut
LOG_MAX_PAYLOAD_SIZE=65535


# ------------------------------------------------------------
# Sécurité API
# ------------------------------------------------------------

# Taille token API généré
API_TOKEN_LENGTH=64

# Expiration token (jours)
API_TOKEN_TTL_DAYS=365


####< VARIABLES A RENSEIGNER #################################


####> VARIABLES CONSTRUITES ##################################

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?serverVersion=${MARIADB_VERSION}-MariaDB&charset=utf8mb4"


# ------------------------------------------------------------
# Mailer
# ------------------------------------------------------------

MAILER_DSN=smtp://${SMTP_USER}:${SMTP_PASSWORD}@${SMTP_HOST}:${SMTP_PORT}?encryption=${SMTP_ENCRYPTION}&auth_mode=login


# ------------------------------------------------------------
# API
# ------------------------------------------------------------

API_INGESTION_ENDPOINT=${APP_URL}/api/logs


# ------------------------------------------------------------
# Dashboard
# ------------------------------------------------------------

DASHBOARD_URL=${APP_URL}/dashboard


####< VARIABLES CONSTRUITES ##################################