<?xml version="1.0" encoding="UTF-8"?>

<!--
============================================================================
PHPUnit Configuration
============================================================================

Configuration principale PHPUnit pour le projet Symfony.

Objectifs :
- logs détaillés
- affichage maximal des erreurs
- gestion stricte des warnings/notices/deprecations
- compatibilité Symfony Bridge
- debug facilité pour développement backend/API/logging

Documentation :
https://phpunit.readthedocs.io/en/latest/configuration.html
-->

<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"

    bootstrap="tests/bootstrap.php"

    cacheDirectory=".phpunit.cache"

    colors="true"

    failOnDeprecation="true"
    failOnNotice="true"
    failOnWarning="true"
    failOnRisky="true"

    beStrictAboutOutputDuringTests="true"

    executionOrder="depends,defects"

    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnPhpunitDeprecations="true"
>

    <!--
    ============================================================================
    Variables PHP / ENV
    ============================================================================

    Configuration du runtime PHP pour les tests.
    -->

    <php>

        <!-- Affichage complet des erreurs -->
        <ini
            name="display_errors"
            value="1"
        />

        <!-- Niveau maximal de reporting -->
        <ini
            name="error_reporting"
            value="-1"
        />

        <!-- Mémoire illimitée -->
        <ini
            name="memory_limit"
            value="-1"
        />

        <!-- Environnement Symfony -->
        <server
            name="APP_ENV"
            value="test"
            force="true"
        />

        <!-- Active le mode debug Symfony -->
        <server
            name="APP_DEBUG"
            value="1"
        />

        <!--
        Verbosité Symfony :

        -1 = silencieux
         1 = normal
         2 = verbose
         3 = debug détaillé
        -->

        <server
            name="SHELL_VERBOSITY"
            value="3"
        />

    </php>

    <!--
    ============================================================================
    Test Suites
    ============================================================================
    -->

    <testsuites>

        <testsuite name="Project Test Suite">

            <directory>
                tests
            </directory>

        </testsuite>

    </testsuites>

    <!--
    ============================================================================
    Source Coverage / Error Filtering
    ============================================================================

    Restriction des warnings/notices/deprecations
    au code applicatif uniquement.
    -->

    <source
        ignoreSuppressionOfDeprecations="true"
        ignoreIndirectDeprecations="true"
        restrictNotices="true"
        restrictWarnings="true"
    >

        <include>

            <directory>
                src
            </directory>

        </include>

        <!--
        ============================================================================
        Doctrine Deprecation Handler
        ============================================================================
        -->

        
    </source>

    <!--
    ============================================================================
    Symfony PHPUnit Bridge
    ============================================================================

    Extensions Symfony :
    - clock mocking
    - dns mocking
    - outils de debug
    -->

    <extensions>

        <bootstrap
            class="Symfony\Bridge\PhpUnit\SymfonyExtension"
        >

            <!-- Mock du temps -->
            <parameter
                name="clock-mock-namespaces"
                value="App"
            />

            <!-- Mock DNS -->
            <parameter
                name="dns-mock-namespaces"
                value="App"
            />

        </bootstrap>

    </extensions>

</phpunit>
