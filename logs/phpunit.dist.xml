<?xml version="1.0" encoding="UTF-8"?>

<!--
============================================================================
PHPUnit Configuration
============================================================================

Configuration principale PHPUnit pour le projet Symfony.

Objectifs :
- robustesse maximale
- affichage détaillé des erreurs
- environnement strict
- isolation des tests
- compatibilité Symfony Bridge
- stabilité CI
- debug simplifié

Documentation :
https://phpunit.readthedocs.io/
-->

<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"

    bootstrap="tests/bootstrap.php"

    cacheDirectory=".phpunit.cache"

    colors="true"

    failOnDeprecation="true"
    failOnNotice="true"
    failOnWarning="true"
    failOnRisky="true"
    failOnIncomplete="true"
    failOnSkipped="false"

    stopOnFailure="false"

    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"

    executionOrder="depends,defects"

    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnPhpunitDeprecations="true"
    displayDetailsOnIncompleteTests="true"
    displayDetailsOnSkippedTests="true"
>

    <!--
    ============================================================================
    Variables PHP / ENV
    ============================================================================

    Configuration du runtime PHP pour les tests.
    -->

    <php>

        <!-- Affichage complet des erreurs -->
        <ini
            name="display_errors"
            value="1"
        />

        <!-- Niveau maximal de reporting -->
        <ini
            name="error_reporting"
            value="-1"
        />

        <!-- Mémoire illimitée -->
        <ini
            name="memory_limit"
            value="-1"
        />

        <!-- Timezone déterministe -->
        <ini
            name="date.timezone"
            value="UTC"
        />

        <!-- Symfony -->
        <server
            name="APP_ENV"
            value="test"
            force="true"
        />

        <server
            name="APP_DEBUG"
            value="1"
            force="true"
        />

        <!-- Verbosité Symfony -->
        <server
            name="SHELL_VERBOSITY"
            value="3"
        />

        <!-- SQLite fichier -->
        <server
            name="DATABASE_URL"
            value="sqlite:///%kernel.project_dir%/var/test.db"
            force="true"
        />

        <!-- Symfony PHPUnit Bridge -->
        <server
            name="SYMFONY_PHPUNIT_REMOVE"
            value=""
        />

        <server
            name="SYMFONY_DEPRECATIONS_HELPER"
            value="max[self]=0"
        />

    </php>

    <!--
    ============================================================================
    Test Suites
    ============================================================================
    -->

    <testsuites>

        <testsuite name="Unit">

            <directory>
                tests/Unit
            </directory>

        </testsuite>

        <testsuite name="Integration">

            <directory>
                tests/Integration
            </directory>

        </testsuite>

        <testsuite name="Functional">

            <directory>
                tests/Functional
            </directory>

        </testsuite>

        <testsuite name="Crash">

            <directory>
                tests/Crash
            </directory>

        </testsuite>

    </testsuites>

    <!--
    ============================================================================
    Source Coverage / Error Filtering
    ============================================================================

    Restriction des warnings/notices/deprecations
    au code applicatif uniquement.
    -->

    <source
        ignoreSuppressionOfDeprecations="true"
        ignoreIndirectDeprecations="true"
        restrictNotices="true"
        restrictWarnings="true"
    >

        <include>

            <directory suffix=".php">
                src
            </directory>

        </include>

        <exclude>

            <directory>
                var
            </directory>

            <directory>
                vendor
            </directory>

            <directory>
                tests
            </directory>

        </exclude>

    </source>

    <!--
    ============================================================================
    Code Coverage
    ============================================================================

    Configuration couverture de code.
    -->

    <coverage
        includeUncoveredFiles="false"
        disableCodeCoverageIgnore="false"
    >

        <report>

            <text
                outputFile="php://stdout"
                showOnlySummary="false"
            />

        </report>

    </coverage>

    <!--
    ============================================================================
    Logging
    ============================================================================

    Logs de tests et rapports CI.
    -->

    <logging>

        <junit
            outputFile="var/phpunit/junit.xml"
        />

        <testdoxText
            outputFile="var/phpunit/testdox.txt"
        />

    </logging>

    <!--
    ============================================================================
    Symfony PHPUnit Bridge
    ============================================================================

    Extensions Symfony :
    - clock mocking
    - dns mocking
    - outils de debug
    -->

    <extensions>

        <bootstrap
            class="Symfony\Bridge\PhpUnit\SymfonyExtension"
        >

            <!-- Mock du temps -->
            <parameter
                name="clock-mock-namespaces"
                value="App"
            />

            <!-- Mock DNS -->
            <parameter
                name="dns-mock-namespaces"
                value="App"
            />

        </bootstrap>

    </extensions>

</phpunit>
