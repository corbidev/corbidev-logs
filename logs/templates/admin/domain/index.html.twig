{% extends 'admin/layout.html.twig' %}

{% block title %}Domaines{% endblock %}

{% block body %}
<main class="admin-page">
    <section class="admin-shell wide">
        <div class="d-flex justify-content-between align-items-center mb-3 admin-topbar">
            <div>
                <h1 class="h3 admin-title">Domaines</h1>
                <p class="admin-subtitle">Configure les domaines fonctionnels et leur statut d'activation.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('admin_tokens') }}" class="btn btn-outline-secondary btn-soft">Tokens</a>
                <a href="{{ path('admin_consumers') }}" class="btn btn-outline-secondary btn-soft">Consumers</a>
                <form method="post" action="{{ path('admin_logout') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_logout') }}">
                    <button class="btn btn-outline-danger btn-soft" type="submit">Deconnexion</button>
                </form>
            </div>
        </div>

        <a href="{{ path('admin_domains_create') }}" class="btn btn-brand text-white mb-3">Creer un domaine</a>

        <div class="table-wrap table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Slug</th>
                        <th>Retention (jours)</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for domain in domains %}
                        <tr>
                            <td>{{ domain.name }}</td>
                            <td><code>{{ domain.slug }}</code></td>
                            <td>{{ domain.retention_days }}</td>
                            <td>
                                {% if domain.is_active %}
                                    <span class="status-pill active">Actif</span>
                                {% else %}
                                    <span class="status-pill inactive">Inactif</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="actions d-flex gap-1 flex-wrap">
                                    <a href="{{ path('admin_domains_edit', {id: domain.id}) }}" class="btn btn-sm btn-warning">Editer</a>
                                    <form method="post" action="{{ path('admin_domains_toggle', {id: domain.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_domain_toggle_' ~ domain.id) }}">
                                        <button class="btn btn-sm btn-secondary" type="submit">Basculer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Aucun domaine configure.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</main>
{% endblock %}
