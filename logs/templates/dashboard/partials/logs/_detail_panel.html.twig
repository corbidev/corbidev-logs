<section class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h2 class="h5 mb-1">Log {{ log.externalId }}</h2>
                <p class="mb-0 text-muted">{{ log.createdAt|date('Y-m-d H:i:s') }} - {{ log.level|upper }} - {{ log.domain }}</p>
            </div>
            <a class="btn btn-outline-secondary btn-soft" href="{{ path('dashboard_logs_show', {'externalId': log.externalId}) }}">Ouvrir la page complete</a>
        </div>

        <dl class="row mb-3">
            <dt class="col-sm-4">External ID</dt>
            <dd class="col-sm-8">{{ log.externalId }}</dd>

            <dt class="col-sm-4">Project ID</dt>
            <dd class="col-sm-8">{{ log.projectId }}</dd>

            <dt class="col-sm-4">Fingerprint</dt>
            <dd class="col-sm-8"><code>{{ log.fingerprint }}</code></dd>

            <dt class="col-sm-4">Request ID</dt>
            <dd class="col-sm-8">{{ log.requestId }}</dd>

            <dt class="col-sm-4">HTTP</dt>
            <dd class="col-sm-8">{{ log.httpStatus }}</dd>

            <dt class="col-sm-4">URI</dt>
            <dd class="col-sm-8 text-break">{{ log.uri }}</dd>
        </dl>

        <h3 class="h6">Message</h3>
        <pre class="mb-3 dashboard-pre-wrap">{{ log.message }}</pre>

        <h3 class="h6">Context</h3>
        <pre class="mb-3 dashboard-pre-wrap">{{ log.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>

        <h3 class="h6">Extra</h3>
        <pre class="mb-3 dashboard-pre-wrap">{{ log.extra|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>

        <h3 class="h6">Ingestion warnings</h3>
        {% if log.ingestionWarnings is empty %}
            <p class="mb-0 text-muted">Aucun warning.</p>
        {% else %}
            <ul class="mb-0">
                {% for warning in log.ingestionWarnings %}
                    <li>{{ warning }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>
