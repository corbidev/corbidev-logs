<div class="table-wrap table-responsive">
    <table class="table align-middle dashboard-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>External ID</th>
                <th>Projet</th>
                <th>Niveau</th>
                <th>HTTP</th>
                <th>Domaine</th>
                <th>URI</th>
                <th>Request ID</th>
                <th>Fingerprint</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr>
                    <td class="mono">{{ item.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td>
                        <a
                            href="{{ path('dashboard_logs_show', {'externalId': item.externalId}) }}"
                            class="log-row-action mono"
                            hx-get="{{ path('dashboard_logs_fragment_detail', {'externalId': item.externalId}) }}"
                            hx-target="#log-detail-region"
                            hx-swap="innerHTML"
                            hx-indicator="#logs-loading-indicator"
                        >{{ item.externalId }}</a>
                    </td>
                    <td>{{ item.projectId }}</td>
                    <td>{% include 'dashboard/components/_level_badge.html.twig' with { level: item.level } only %}</td>
                    <td>{% include 'dashboard/components/_http_badge.html.twig' with { status: item.httpStatus } only %}</td>
                    <td>{{ item.domain }}</td>
                    <td><span class="text-wrap-break">{{ item.uri }}</span></td>
                    <td class="mono text-wrap-break">{{ item.requestId }}</td>
                    <td><code class="mono">{{ item.fingerprint }}</code></td>
                    <td>
                        {% if item.message|length > 90 %}
                            {{ item.message|slice(0, 90) ~ '...' }}
                        {% else %}
                            {{ item.message }}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">Aucun log disponible.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
