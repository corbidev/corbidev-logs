<div class="table-wrap table-responsive">
    <table class="table align-middle dashboard-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Domaine ID</th>
                <th>Niveau</th>
                <th>HTTP</th>
                <th>Domaine</th>
                <th>URI</th>
                <th>Request ID</th>
                <th>Fingerprint</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr class="dashboard-log-row" data-external-id="{{ item.externalId }}" role="button" tabindex="0" aria-label="Ouvrir les details du log {{ item.externalId }}">
                    <td class="mono" data-label="Date">{{ item.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td data-label="Domaine ID">{{ item.domainId }}</td>
                    <td data-label="Niveau">{% include 'dashboard/components/_level_badge.html.twig' with { level: item.level } only %}</td>
                    <td data-label="HTTP">{% include 'dashboard/components/_http_badge.html.twig' with { status: item.httpStatus } only %}</td>
                    <td data-label="Domaine">{{ item.domain }}</td>
                    <td data-label="URI"><span class="text-wrap-break">{{ item.uri }}</span></td>
                    <td class="mono text-wrap-break" data-label="Request ID">{{ item.requestId }}</td>
                    <td data-label="Fingerprint"><code class="mono">{{ item.fingerprint }}</code></td>
                    <td data-label="Message">
                        {% if item.message|length > 90 %}
                            {{ item.message|slice(0, 90) ~ '...' }}
                        {% else %}
                            {{ item.message }}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">Aucun log disponible.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
