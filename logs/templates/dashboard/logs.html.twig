{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard - Logs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .dashboard-shell {
            max-width: none;
            width: 100%;
        }

        .dashboard-table {
            font-size: 0.76rem;
            line-height: 1.2;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        }

        .dashboard-table,
        .dashboard-table th,
        .dashboard-table td,
        .dashboard-table a,
        .dashboard-table code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
            font-size: inherit;
        }

        .dashboard-table thead th {
            font-size: 0.69rem;
            white-space: nowrap;
            padding: 0.42rem 0.48rem;
        }

        .dashboard-table td {
            padding: 0.4rem 0.48rem;
            vertical-align: top;
        }

        .mono {
            font-family: inherit;
            font-size: inherit;
        }

        .dashboard-filters {
            background: linear-gradient(180deg, #ffffff 0%, #f9fcff 100%);
            border: 1px solid #d9e3ef;
            border-radius: 14px;
            padding: 0.9rem;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
            max-height: 1200px;
            opacity: 1;
            overflow: hidden;
            transform-origin: top;
            transform: translateY(0) scaleY(1);
            will-change: max-height, opacity, transform;
            transition: max-height 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease, transform 300ms cubic-bezier(0.22, 1, 0.36, 1), margin 300ms cubic-bezier(0.22, 1, 0.36, 1);
        }

        .dashboard-filters.is-collapsed {
            max-height: 0;
            opacity: 0;
            transform: translateY(-6px) scaleY(0.98);
            padding-top: 0;
            padding-bottom: 0;
            border-width: 0;
            margin: 0;
            box-shadow: none;
            pointer-events: none;
        }

        .dashboard-filters .form-label {
            font-size: 0.82rem;
            margin-bottom: 0.32rem;
            color: #30445d;
        }

        .dashboard-filters .form-control,
        .dashboard-filters .form-select {
            min-height: 42px;
            border-radius: 10px;
            border-color: #cfdbe8;
            font-size: 0.9rem;
            background: #fff;
        }

        .dashboard-filters .btn {
            min-height: 42px;
        }

        .dashboard-filters .btn-outline-secondary {
            border-color: #becddd;
            color: #2f4a65;
            background: #f7fbff;
        }

        .dashboard-filters .btn-outline-secondary:hover {
            background: #eef6ff;
            border-color: #a9bfd6;
        }

        .text-wrap-break {
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .log-row-action {
            color: #0a4bc8;
            text-decoration: none;
            cursor: pointer;
            font-weight: 600;
        }

        .log-row-action:hover {
            text-decoration: underline;
        }

        .filters-toggle {
            display: inline-flex;
            align-items: center;
            gap: 0.42rem;
            min-height: 40px;
            border-radius: 10px;
        }

        .filters-toggle .icon {
            position: relative;
            width: 16px;
            height: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .filters-toggle .icon span {
            position: absolute;
            left: 1px;
            width: 14px;
            height: 2px;
            border-radius: 2px;
            background: currentColor;
            transform-origin: center;
            transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms ease, top 220ms cubic-bezier(0.22, 1, 0.36, 1);
        }

        .filters-toggle .icon span:nth-child(1) {
            top: 1px;
        }

        .filters-toggle .icon span:nth-child(2) {
            top: 6px;
        }

        .filters-toggle .icon span:nth-child(3) {
            top: 11px;
        }

        .filters-toggle[aria-expanded="true"] .icon span:nth-child(1) {
            top: 6px;
            transform: rotate(45deg);
        }

        .filters-toggle[aria-expanded="true"] .icon span:nth-child(2) {
            opacity: 0;
            transform: scaleX(0.3);
        }

        .filters-toggle[aria-expanded="true"] .icon span:nth-child(3) {
            top: 6px;
            transform: rotate(-45deg);
        }

        .level-badge,
        .http-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 3.8rem;
            padding: 0.16rem 0.5rem;
            border-radius: 999px;
            border: 1px solid transparent;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            line-height: 1.2;
            white-space: nowrap;
        }

        .level-badge.is-error,
        .level-badge.is-critical,
        .http-badge.is-5xx {
            color: #9a3f3f;
            background: #fff1ef;
            border-color: #ffd8d3;
        }

        .level-badge.is-warning,
        .http-badge.is-4xx {
            color: #9a6b24;
            background: #fff7ea;
            border-color: #ffe4bb;
        }

        .level-badge.is-info,
        .level-badge.is-notice,
        .level-badge.is-debug,
        .http-badge.is-2xx,
        .http-badge.is-3xx {
            color: #225f8f;
            background: #eef7ff;
            border-color: #d3e8fa;
        }

        .http-badge.is-other,
        .level-badge.is-other {
            color: #4c5e74;
            background: #f2f6fa;
            border-color: #dbe4ee;
        }

        .log-clickable-row {
            cursor: pointer;
        }

        .log-clickable-row:hover {
            background: #f7fbff;
        }

        .log-clickable-row.severity-critical,
        .log-clickable-row.severity-error {
            background: #fff7f5;
        }

        .log-clickable-row.severity-critical:hover,
        .log-clickable-row.severity-error:hover {
            background: #ffefea;
        }

        .log-clickable-row.severity-warning {
            background: #fffaf2;
        }

        .log-clickable-row.severity-warning:hover {
            background: #fff4e6;
        }

        .log-clickable-row.severity-notice,
        .log-clickable-row.severity-info,
        .log-clickable-row.severity-debug {
            background: #f6fbff;
        }

        .log-clickable-row.severity-notice:hover,
        .log-clickable-row.severity-info:hover,
        .log-clickable-row.severity-debug:hover {
            background: #eef7ff;
        }

        .log-clickable-row:focus-visible {
            outline: 2px solid #67d8bf;
            outline-offset: -2px;
        }

        .log-modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(20, 33, 61, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1080;
            padding: 1rem;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 220ms ease, visibility 220ms ease;
        }

        .log-modal-backdrop.is-open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .log-modal {
            width: min(1100px, 100%);
            max-height: calc(100vh - 2rem);
            overflow: auto;
            background: #fff;
            border-radius: 16px;
            border: 1px solid var(--line);
            box-shadow: 0 30px 60px rgba(20, 33, 61, 0.2);
            transform: translateY(10px) scale(0.985);
            opacity: 0;
            transition: transform 230ms ease, opacity 230ms ease;
        }

        .log-modal-backdrop.is-open .log-modal {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        .log-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem 1.1rem;
            border-bottom: 1px solid var(--line);
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 1;
        }

        .log-modal-body {
            padding: 1rem 1.1rem;
            font-size: 0.84rem;
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
        }

        .log-modal-grid {
            display: grid;
            grid-template-columns: 190px 1fr;
            gap: 0.35rem 0.8rem;
        }

        .log-modal-grid dt {
            margin: 0;
            color: #4b596d;
            font-weight: 700;
        }

        .log-modal-grid dd {
            margin: 0;
        }

        .log-modal-card {
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 0.8rem;
            margin-top: 0.8rem;
            background: #fcfefe;
        }

        .log-modal-card h4 {
            margin: 0 0 0.5rem;
            font-size: 0.9rem;
        }

        .log-modal-card pre {
            margin: 0;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            font-size: 0.74rem;
            background: #f7fafc;
            border: 1px solid #e8eef5;
            border-radius: 8px;
            padding: 0.65rem;
        }

        @media (max-width: 992px) {
            .log-modal-grid {
                grid-template-columns: 1fr;
            }

            .dashboard-table {
                font-size: 0.74rem;
            }

            .dashboard-filters {
                padding: 0.7rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
<main class="admin-page">
    <section class="admin-shell dashboard-shell">
        <div class="d-flex justify-content-between align-items-center mb-3 admin-topbar">
            <div>
                <h1 class="h3 admin-title">Dashboard Logs</h1>
                <p class="admin-subtitle">Vue filtrable des logs persistes.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-outline-secondary btn-soft filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="dashboard-filters-panel">
                    <span class="icon" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span>Filtres</span>
                </button>
                <p class="mb-0 text-muted">Total: {{ totalCount }}</p>
            </div>
        </div>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-body dashboard-filters is-collapsed" id="dashboard-filters-panel">
                <form method="get" action="{{ path('dashboard_logs_index') }}" class="row g-2 align-items-end">
                    <input type="hidden" name="filters_panel" id="filters-panel-input" value="{{ app.request.query.get('filters_panel', 'closed') }}">
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Date debut</label>
                        <input class="form-control" type="datetime-local" name="from_date" value="{{ filters.from_date }}">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Date fin</label>
                        <input class="form-control" type="datetime-local" name="to_date" value="{{ filters.to_date }}">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Niveau</label>
                        <select class="form-select" name="level">
                            <option value="">Tous</option>
                            {% for level in levels %}
                                <option value="{{ level }}" {% if filters.level == level %}selected{% endif %}>{{ level }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Domaine</label>
                        <select class="form-select" name="domain">
                            <option value="">Tous</option>
                            {% for domain in domains %}
                                <option value="{{ domain }}" {% if filters.domain == domain %}selected{% endif %}>{{ domain }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Projet</label>
                        <select class="form-select" name="project_id">
                            <option value="">Tous</option>
                            {% for project in projects %}
                                <option value="{{ project.id }}" {% if filters.project_id == (project.id ~ '') %}selected{% endif %}>
                                    {{ project.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Fingerprint</label>
                        <input class="form-control" name="fingerprint" value="{{ filters.fingerprint }}" placeholder="16 chars">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Recherche globale</label>
                        <input class="form-control" name="q" value="{{ filters.q }}" placeholder="message, URI, requestId, externalId">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold">Par page</label>
                        <select class="form-select" name="per_page">
                            {% for option in [25, 50, 100, 200] %}
                                <option value="{{ option }}" {% if perPage == option %}selected{% endif %}>{{ option }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-brand text-white flex-grow-1">Filtrer</button>
                        <a href="{{ path('dashboard_logs_index', {'filters_panel': app.request.query.get('filters_panel', 'closed')}) }}" class="btn btn-outline-secondary btn-soft">Reset</a>
                    </div>
                </form>
            </div>
        </section>

        <section class="mb-3 text-muted">
            Page {{ page }} / {{ totalPages }} - {{ perPage }} elements par page
        </section>

        <div class="table-wrap table-responsive">
            <table class="table align-middle dashboard-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>External ID</th>
                        <th>Projet</th>
                        <th>Niveau</th>
                        <th>HTTP</th>
                        <th>Domaine</th>
                        <th>URI</th>
                        <th>Request ID</th>
                        <th>Fingerprint</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {% set level = item.level|lower %}
                        <tr
                            class="log-clickable-row js-log-detail-row severity-{{ level }}"
                            data-external-id="{{ item.externalId }}"
                            tabindex="0"
                            role="button"
                            aria-label="Ouvrir le detail du log {{ item.externalId }}"
                        >
                            <td class="mono">{{ item.createdAt|date('Y-m-d H:i:s') }}</td>
                            <td>
                                <a
                                    href="{{ path('dashboard_logs_show', {'externalId': item.externalId}) }}"
                                    class="log-row-action mono"
                                >{{ item.externalId }}</a>
                            </td>
                            <td>{{ item.projectId }}</td>
                            <td>
                                <span class="level-badge
                                    {% if level in ['critical', 'error'] %}is-{{ level }}
                                    {% elseif level == 'warning' %}is-warning
                                    {% elseif level == 'info' %}is-info
                                    {% elseif level == 'notice' %}is-notice
                                    {% elseif level == 'debug' %}is-debug
                                    {% else %}is-other{% endif %}">
                                    {{ item.level|upper }}
                                </span>
                            </td>
                            <td>
                                {% set status = item.httpStatus %}
                                <span class="http-badge
                                    {% if status >= 500 and status < 600 %}is-5xx
                                    {% elseif status >= 400 and status < 500 %}is-4xx
                                    {% elseif status >= 300 and status < 400 %}is-3xx
                                    {% elseif status >= 200 and status < 300 %}is-2xx
                                    {% else %}is-other{% endif %}">
                                    {{ item.httpStatus }}
                                </span>
                            </td>
                            <td>{{ item.domain }}</td>
                            <td><span class="text-wrap-break">{{ item.uri }}</span></td>
                            <td class="mono text-wrap-break">{{ item.requestId }}</td>
                            <td><code class="mono">{{ item.fingerprint }}</code></td>
                            <td>
                                {% if item.message|length > 90 %}
                                    {{ item.message|slice(0, 90) ~ '...' }}
                                {% else %}
                                    {{ item.message }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">Aucun log disponible.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <nav class="d-flex gap-2 mt-3">
            {% if page > 1 %}
                <a class="btn btn-outline-secondary btn-soft" href="{{ path('dashboard_logs_index', paginationParams|merge({'page': page - 1, 'filters_panel': app.request.query.get('filters_panel', 'closed')})) }}">Page precedente</a>
            {% endif %}

            {% if page < totalPages %}
                <a class="btn btn-outline-secondary btn-soft" href="{{ path('dashboard_logs_index', paginationParams|merge({'page': page + 1, 'filters_panel': app.request.query.get('filters_panel', 'closed')})) }}">Page suivante</a>
            {% endif %}
        </nav>
    </section>
</main>

<div class="log-modal-backdrop" id="log-detail-modal" aria-hidden="true">
    <section class="log-modal" role="dialog" aria-modal="true" aria-labelledby="log-detail-title">
        <header class="log-modal-header">
            <div>
                <h3 id="log-detail-title" class="h5 mb-1">Detail du log</h3>
                <p class="mb-0 text-muted mono" id="log-detail-subtitle">Chargement...</p>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-soft" id="log-detail-close">Fermer</button>
        </header>
        <div class="log-modal-body">
            <dl class="log-modal-grid" id="log-detail-grid"></dl>

            <article class="log-modal-card">
                <h4>Message</h4>
                <pre id="log-detail-message"></pre>
            </article>

            <article class="log-modal-card">
                <h4>Context</h4>
                <pre id="log-detail-context"></pre>
            </article>

            <article class="log-modal-card">
                <h4>Extra</h4>
                <pre id="log-detail-extra"></pre>
            </article>

            <article class="log-modal-card">
                <h4>Ingestion warnings</h4>
                <pre id="log-detail-warnings"></pre>
            </article>
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            function initDashboardLogs() {
                const filtersToggle = document.getElementById('filters-toggle');
                const filtersPanel = document.getElementById('dashboard-filters-panel');
                const filtersPanelInput = document.getElementById('filters-panel-input');
                const endpointTemplate = '{{ path('dashboard_logs_show_json', {'externalId': '__EXTERNAL_ID__'}) }}';
                const filtersPanelQueryKey = 'filters_panel';

                function readFiltersPanelStateFromUrl() {
                    try {
                        const params = new URL(window.location.href).searchParams;
                        return params.get(filtersPanelQueryKey) === 'open' ? 'open' : 'closed';
                    } catch (error) {
                        return 'closed';
                    }
                }

                function writeFiltersPanelStateInUrl(expanded) {
                    try {
                        const url = new URL(window.location.href);
                        url.searchParams.set(filtersPanelQueryKey, expanded ? 'open' : 'closed');
                        window.history.replaceState(null, '', url.toString());
                    } catch (error) {
                        // No-op: older contexts may not support URL/history APIs.
                    }
                }

                function applyFiltersVisibility(expanded) {
                    if (!filtersToggle || !filtersPanel) {
                        return;
                    }

                    filtersPanel.classList.toggle('is-collapsed', !expanded);
                    filtersToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                    if (filtersPanelInput) {
                        filtersPanelInput.value = expanded ? 'open' : 'closed';
                    }
                    writeFiltersPanelStateInUrl(expanded);
                }

                if (filtersToggle && filtersPanel) {
                    applyFiltersVisibility(readFiltersPanelStateFromUrl() === 'open');

                    filtersToggle.addEventListener('click', function () {
                        const expanded = filtersToggle.getAttribute('aria-expanded') === 'true';
                        applyFiltersVisibility(!expanded);
                    });
                }

                const modal = document.getElementById('log-detail-modal');
                const closeButton = document.getElementById('log-detail-close');
                const subtitle = document.getElementById('log-detail-subtitle');
                const grid = document.getElementById('log-detail-grid');
                const message = document.getElementById('log-detail-message');
                const context = document.getElementById('log-detail-context');
                const extra = document.getElementById('log-detail-extra');
                const warnings = document.getElementById('log-detail-warnings');

                if (!modal || !closeButton || !subtitle || !grid || !message || !context || !extra || !warnings) {
                    return;
                }

                function openModal() {
                    modal.classList.add('is-open');
                    modal.setAttribute('aria-hidden', 'false');
                }

                function closeModal() {
                    modal.classList.remove('is-open');
                    modal.setAttribute('aria-hidden', 'true');
                }

                function prettyJson(value) {
                    return JSON.stringify(value ?? {}, null, 2);
                }

                function renderGrid(data) {
                    const fields = [
                        ['External ID', data.externalId],
                        ['Date', data.createdAt],
                        ['Project ID', data.projectId],
                        ['Level', data.level],
                        ['HTTP', data.httpStatus],
                        ['Domain', data.domain],
                        ['URI', data.uri],
                        ['Method', data.method || 'n/a'],
                        ['Request ID', data.requestId],
                        ['Fingerprint', data.fingerprint],
                        ['Client', data.client],
                        ['Environment', data.env],
                        ['IP', data.ip || 'n/a'],
                        ['Client date', data.clientDate || 'n/a'],
                        ['User Agent', data.userAgent || 'n/a']
                    ];

                    grid.innerHTML = fields.map(([label, value]) => {
                        return '<dt>' + label + '</dt><dd class="text-wrap-break">' + String(value ?? '') + '</dd>';
                    }).join('');
                }

                async function loadDetails(externalId) {
                    subtitle.textContent = externalId;
                    message.textContent = 'Chargement...';
                    context.textContent = '';
                    extra.textContent = '';
                    warnings.textContent = '';
                    grid.innerHTML = '';

                    const url = endpointTemplate.replace('__EXTERNAL_ID__', encodeURIComponent(externalId));

                    const response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    const payload = await response.json();

                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || 'Impossible de charger le detail du log.');
                    }

                    const data = payload.data;
                    subtitle.textContent = data.externalId;
                    renderGrid(data);
                    message.textContent = data.message || '';
                    context.textContent = prettyJson(data.context);
                    extra.textContent = prettyJson(data.extra);
                    warnings.textContent = Array.isArray(data.ingestionWarnings) && data.ingestionWarnings.length > 0
                        ? data.ingestionWarnings.join('\n')
                        : 'Aucun warning.';
                }

                async function openDetailsFor(externalId) {
                    if (!externalId) {
                        return;
                    }

                    openModal();

                    try {
                        await loadDetails(externalId);
                    } catch (error) {
                        subtitle.textContent = externalId;
                        message.textContent = error instanceof Error ? error.message : 'Erreur inattendue.';
                        context.textContent = '';
                        extra.textContent = '';
                        warnings.textContent = '';
                    }
                }

                document.querySelectorAll('.js-log-detail-row').forEach((row) => {
                    row.addEventListener('click', async function (event) {
                        if (event.target instanceof Element && event.target.closest('a')) {
                            return;
                        }

                        const externalId = this.getAttribute('data-external-id');
                        await openDetailsFor(externalId);
                    });

                    row.addEventListener('keydown', async function (event) {
                        if (event.key !== 'Enter' && event.key !== ' ') {
                            return;
                        }

                        event.preventDefault();

                        const externalId = this.getAttribute('data-external-id');
                        await openDetailsFor(externalId);
                    });
                });

                document.querySelectorAll('.log-row-action').forEach((link) => {
                    link.addEventListener('click', async function (event) {
                        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                            return;
                        }

                        event.preventDefault();
                        event.stopPropagation();

                        const row = this.closest('.js-log-detail-row');
                        const externalId = row ? row.getAttribute('data-external-id') : this.textContent;

                        try {
                            await openDetailsFor(externalId);
                        } catch (error) {
                            window.location.href = this.getAttribute('href') || '';
                        }
                    });
                });

                closeButton.addEventListener('click', closeModal);

                modal.addEventListener('click', function (event) {
                    if (event.target === modal) {
                        closeModal();
                    }
                });

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                        closeModal();
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initDashboardLogs, { once: true });
            } else {
                initDashboardLogs();
            }
        })();
    </script>
{% endblock %}
