{% extends 'admin/layout.html.twig' %}

{% block title %}Dashboard - Log {{ log.externalId }}{% endblock %}

{% block body %}
<main class="admin-page">
    <section class="admin-shell wide">
        <header class="d-flex justify-content-between align-items-center gap-3 mb-3 admin-topbar">
            <div>
                <h1 class="h3 admin-title mb-1">Log {{ log.externalId }}</h1>
                <p class="admin-subtitle mb-0">{{ log.createdAt|date('Y-m-d H:i:s') }} - {{ log.level|upper }} - {{ log.domain }}</p>
            </div>
            <a class="btn btn-outline-secondary btn-soft" href="{{ path('dashboard_logs_index') }}">Retour a la liste</a>
        </header>

        <section class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5 mb-3">Donnees principales</h2>

                <dl class="row mb-0">
            <dt>External ID</dt>
            <dd>{{ log.externalId }}</dd>

            <dt>Project ID</dt>
            <dd>{{ log.projectId }}</dd>

            <dt>Fingerprint</dt>
            <dd>{{ log.fingerprint }}</dd>

            <dt>Request ID</dt>
            <dd>{{ log.requestId }}</dd>

            <dt>HTTP status</dt>
            <dd>{{ log.httpStatus }}</dd>

            <dt>Method</dt>
            <dd>{{ log.method ?? 'n/a' }}</dd>

            <dt>URI</dt>
            <dd class="text-break">{{ log.uri }}</dd>

            <dt>Environment</dt>
            <dd>{{ log.env }}</dd>

            <dt>Client</dt>
            <dd>{{ log.client }}</dd>

            <dt>User Agent</dt>
            <dd class="text-break">{{ log.userAgent ?? 'n/a' }}</dd>

            <dt>IP</dt>
            <dd>{{ log.ip ?? 'n/a' }}</dd>

            <dt>Client date</dt>
            <dd>{{ log.clientDate ? log.clientDate|date('Y-m-d H:i:s') : 'n/a' }}</dd>
        </dl>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5 mb-3">Message</h2>
                <pre class="mb-0" style="white-space: pre-wrap;">{{ log.message }}</pre>
            </div>
        </section>

        <section class="row g-3">
            <article class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Context</h2>
                        <pre class="mb-0" style="white-space: pre-wrap;">{{ log.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    </div>
                </div>
            </article>

            <article class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Extra</h2>
                        <pre class="mb-0" style="white-space: pre-wrap;">{{ log.extra|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    </div>
                </div>
            </article>

            <article class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Ingestion warnings</h2>
                        {% if log.ingestionWarnings is empty %}
                            <p class="mb-0 text-muted">Aucun warning.</p>
                        {% else %}
                            <ul class="mb-0">
                                {% for warning in log.ingestionWarnings %}
                                    <li>{{ warning }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </article>
        </section>
    </section>
</main>
{% endblock %}